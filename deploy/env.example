# انسخ هذا الملف إلى .env في جذر المستودع واملأ القيم. لا تُرفع .env إلى المستودع.

# كلمة مرور قاعدة البيانات (عشوائية طويلة)
POSTGRES_PASSWORD=
# سر توقيع JWT (32 حرفًا على الأقل):  openssl rand -base64 48
GBCFMS_JWT_SECRET=
# مفتاح تشفير النسخ الاحتياطية AES-256 بصيغة base64 (32 بايت):  openssl rand -base64 32
# احفظ نسخة منه خارج الخادم؛ بدونه لا تُستعاد النسخ المشفرة.
GBCFMS_BACKUP_KEY=

# مجلد النسخ الاحتياطية على المضيف (قرص خارجي أو NAS مركب)
BACKUP_DIR=./backups
# مجلد الشهادة: server.crt و server.key  (make certs يولد شهادة موقعة ذاتيًا للتجربة)
CERTS_DIR=./deploy/certs
HTTPS_PORT=443
HTTP_PORT=80
GBCFMS_WORKERS=4
TZ=Africa/Tripoli

# المساعد الذكي (معطل افتراضيًا؛ قرار D-14: أرقام مجمعة فقط)
GBCFMS_AI_ENABLED=false
GBCFMS_AI_MODEL=claude-opus-5
GBCFMS_AI_MASK_PERSONAL=true
ANTHROPIC_API_KEY=
# وكيل HTTPS للخروج إلى الإنترنت إن وُجد (الاتصال من الخادم فقط، لا من المتصفح)
AI_HTTPS_PROXY=
