# ملف اختياري: انسخه إلى .env في جذر المشروع فقط إذا أردت تغيير الإعدادات الافتراضية.
# الأسرار (كلمة مرور قاعدة البيانات، سر JWT، مفتاح تشفير النسخ) تُولَّد تلقائيًا عند أول تشغيل
# وتُحفظ في volume «secrets». لعرض مفتاح النسخ وحفظه: make backup-key  أو  windows\backup-key.cmd

# عند نقل النظام إلى خادم جديد واستعادة نسخة احتياطية: ضع المفتاح المحفوظ هنا
# GBCFMS_BACKUP_KEY=

# مجلد النسخ الاحتياطية على المضيف (قرص خارجي أو NAS مركب)
BACKUP_DIR=./backups
# مجلد شهادة الجهة: server.crt و server.key. إن لم توجد تُولَّد شهادة موقعة ذاتيًا
CERTS_DIR=./deploy/certs
# اسم الخادم في الشهادة المولّدة تلقائيًا
GBCFMS_HOST=localhost
HTTPS_PORT=443
HTTP_PORT=80
GBCFMS_WORKERS=4
TZ=Africa/Tripoli

# المساعد الذكي (معطل افتراضيًا؛ قرار D-14: أرقام مجمعة فقط)
GBCFMS_AI_ENABLED=false
GBCFMS_AI_MODEL=claude-opus-5
GBCFMS_AI_MASK_PERSONAL=true
ANTHROPIC_API_KEY=
# وكيل HTTPS للخروج إلى الإنترنت إن وُجد (الاتصال من الخادم فقط، لا من المتصفح)
AI_HTTPS_PROXY=
